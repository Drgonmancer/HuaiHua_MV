# Copy this file to .env and fill only the providers you intend to use.
# No automatic generation requests run at startup. Restart after editing.
# BASE_URL includes the provider's API prefix, e.g. https://HOST/v1.
# Configure a local relay with http://127.0.0.1:PORT/v1 if needed.
# Secrets are never returned by /api/studio/settings.
TEXT_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL=
TEXT_MODELS=
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_MODELS=
AUDIO_BASE_URL=
AUDIO_API_KEY=
AUDIO_MODEL=
AUDIO_MODELS=
# openai: OpenAI /audio/speech protocol (default). clone: local voice-clone
# server speaking the GPT-SoVITS api_v2 JSON contract at BASE_URL + /tts
# (works with locally deployed GPT-SoVITS or CosyVoice2-compatible wrappers).
AUDIO_PROTOCOL=
# Comma-separated voice IDs supported by your selected speech provider.
# Default when blank: alloy,echo,fable,onyx,nova,shimmer (openai protocol only)
AUDIO_VOICES=
# Languages for the clone protocol (default both: zh). Examples: zh, en, ja.
AUDIO_TEXT_LANG=
AUDIO_PROMPT_LANG=
# Optional absolute path the clone server uses to read the same media files,
# e.g. when it runs in Docker with data/studio-media mounted elsewhere.
AUDIO_CLONE_MEDIA_ROOT=
VIDEO_BASE_URL=
VIDEO_API_KEY=
VIDEO_MODEL=
VIDEO_MODELS=
# seedance: BASE_URL ends in /api/v3, then /contents/generations/tasks.
# openai: BASE_URL ends in /v1, then /videos and /videos/{id}/content.
# Blank defaults to seedance. Provider/model support must be verified locally.
VIDEO_PROTOCOL=
# Optional local limits. Defaults: workers=2, max total pending=16, poll=3 sec.
MAX_WORKERS=
MAX_PENDING=
VIDEO_POLL_INTERVAL=
# Auto subtitles run locally with faster-whisper (pip install faster-whisper).
# Model sizes: tiny/base/small/medium/large-v3. Blank defaults to small;
# first use downloads the model to data/models/whisper.
SUBTITLE_WHISPER_MODEL=
SUBTITLE_WHISPER_DEVICE=
SUBTITLE_WHISPER_COMPUTE=
